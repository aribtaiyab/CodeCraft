# CodeCraft Server Environment Configuration (Phase 5)
# NEVER commit real API keys to version control.
# Copy this file to .env and insert your local Groq API key:
#   cp .env.example .env

# Server port for the CodeCraft backend API
PORT=3001

# Groq API Key (Server-only - never expose to browser/client bundles)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Selection (default: llama-3.3-70b-versatile, fallback: llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional comma-separated origins for production CORS (e.g. https://codecraft.example.com)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
